# FrontVantardSoftwareStudio (.env.example)
# Copia este archivo a .env y ajusta valores por ambiente.
# IMPORTANTE: .env NO se sube al repo.

VITE_API_URL=http://localhost:8000
VITE_APP_NAME=VantardSoftwareStudio

# Cifrado AES-256-CBC — endpoint password-reset/confirm
# El IV se genera aleatoriamente en cada cifrado (no se configura aquí).
VITE_AES_KEY=CHANGE_ME_32_CHARS_EXACTLY_HERE!

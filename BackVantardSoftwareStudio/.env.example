# BackVantardSoftwareStudio (.env.example)
# Copia este archivo a .env y ajusta valores por ambiente.
# IMPORTANTE: .env NO se sube al repo.

# Django
SECRET_KEY=CHANGE_ME
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Base de datos (MySQL)
DB_NAME=vantard_db
DB_USER=root
DB_PASSWORD=CHANGE_ME
DB_HOST=127.0.0.1
DB_PORT=3306

# JWT
JWT_SECRET=CHANGE_ME

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Deployments
DEPLOYMENT_BASE_URL=http://localhost:8000

# Frontend URL (para enlaces de reset de contraseña en correos)
FRONTEND_URL=http://localhost:5173

# Tiempo de validez del token de restablecimiento en segundos (1 hora = 3600)
PASSWORD_RESET_TIMEOUT=3600

# ---------------------------------------------------------------------------
# Correo SMTP — Gmail
# ---------------------------------------------------------------------------
# Dev: usar console para imprimir en terminal sin credenciales reales
#   EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Prod: usar smtp con App Password de Google (16 caracteres)
#   Generarla en: Google Account → Seguridad → Contraseñas de aplicaciones
#
# IMPORTANTE — puerto 465 vs 587:
#   Puerto 465 → EMAIL_USE_TLS=False + EMAIL_USE_SSL=True  (recomendado, menos restricciones de red)
#   Puerto 587 → EMAIL_USE_TLS=True  + EMAIL_USE_SSL=False
#   TLS y SSL son mutuamente excluyentes en Django — solo uno puede ser True.
#
# IMPORTANTE — DEFAULT_FROM_EMAIL debe coincidir exactamente con EMAIL_HOST_USER.
#   Si el dominio no coincide, Gmail rechaza el envío.
#   Formato correcto: Nombre Visible <tu_correo@gmail.com>

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_HOST_USER=tu_correo@gmail.com
EMAIL_HOST_PASSWORD=abcd efgh ijkl mnop
DEFAULT_FROM_EMAIL=VSS <tu_correo@gmail.com>

# ---------------------------------------------------------------------------
# Cifrado AES-256-CBC — endpoint password-reset/confirm
# ---------------------------------------------------------------------------
# AES_SECRET_KEY: exactamente 32 caracteres (AES-256)
# AES_IV:         exactamente 16 caracteres
AES_SECRET_KEY=CHANGE_ME_32_CHARS_EXACTLY_HERE!
AES_IV=CHANGE_ME_16CHARS

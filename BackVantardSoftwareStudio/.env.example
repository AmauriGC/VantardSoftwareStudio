Haya un pailot en nuestro proyecto.

# BackVantardSoftwareStudio (.env.example)
# Copia este archivo a .env y ajusta valores por ambiente.
# IMPORTANTE: .env NO se sube al repo.

# Django
SECRET_KEY=CHANGE_ME
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Base de datos (estándar: MySQL). Ejemplo con DATABASE_URL:
# Formato: mysql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=mysql://user:password@127.0.0.1:3306/vantard_db

# JWT
JWT_SECRET=CHANGE_ME

# (Opcional) Si más adelante se agrega CORS/CSRF
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Frontend para enlaces de recuperación
FRONTEND_URL=http://localhost:5173

# Correo SMTP (recomendado para recuperación real)
# Gmail ejemplo:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu_correo@gmail.com
# EMAIL_HOST_PASSWORD=tu_app_password_16_caracteres
# DEFAULT_FROM_EMAIL=Vantard Studio <tu_correo@gmail.com>
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@vantard.local


# =============================
# VantardSoftwareStudio (monorepo)
# Un solo .gitignore para todo el repo
# =============================

# --- Environment / secrets (NO commitear) ---
.env
.env.*
!.env.example
!.env.*.example

# SonarQube (token local va por variable de entorno, no en archivo)
.sonar/
sonar-project.local.properties

# Guías / documentación interna (no es código del repo)
Guías/
Guias/

# --- Python ---
__pycache__/
*.py[cod]
*.pyd
*.pyo

# Entornos virtuales
.venv/
venv/
env/

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/

# --- Django ---
db.sqlite3
db.sqlite3-journal
staticfiles/
media/

# Migraciones (ignorar archivos generados, pero mantener el paquete)
BackVantardSoftwareStudio/**/migrations/*.py
!BackVantardSoftwareStudio/**/migrations/__init__.py

# --- Node / Vite ---
node_modules/
dist/
dist-ssr/
build/
.vite/
*.local

# Lockfile (evitar cambios ruidosos si no se versiona)
package-lock.json

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Editor / IDE ---
.vscode/*
!.vscode/extensions.json
.idea/

# Visual Studio / Windows
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- OS ---
.DS_Store
Thumbs.db
